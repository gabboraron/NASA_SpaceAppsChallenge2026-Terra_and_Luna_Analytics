{
  "$schema": "https://json-schema.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(uv lock:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(python -m uv:*)",
      "Bash(.venv/bin/python -m ruff:*)",
      "Bash(.venv/Scripts/python.exe -m ruff:*)",
      "Bash(.venv/bin/python -m pyright:*)",
      "Bash(.venv/Scripts/python.exe -m pyright:*)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",
      "Bash(python -m pip:*)",
      "Bash(.venv/bin/python -m pip:*)",
      "Bash(.venv/Scripts/python.exe -m pip:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .claude/hooks/py_check.py",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@anthropic-plugin-directory": true,
    "mattpocock-skills@claude-plugins-official": true,
    "code-review-anthropics@anthropic-plugin-directory": true,
    "code-simplifier@anthropic-plugin-directory": true,
    "claude-md-management@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true
  }
}
